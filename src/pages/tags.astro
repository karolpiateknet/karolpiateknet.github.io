---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = await getCollection('posts');
const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    const key = tag.toLowerCase();
    tagCounts.set(key, (tagCounts.get(key) ?? 0) + 1);
  }
}
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---
<Base title="Tags">
  <section class="page-head" aria-labelledby="tags-title">
    <h1 id="tags-title">Tags</h1>
    <p class="page-head__lede">Every post by topic. For the AI work in order, follow <a href="/ai-for-teams">AI for teams</a>.</p>
  </section>
  <ul class="tag-index">
    {tags.map(([tag, count]) => (
      <li><a href={`/tags/${tag}`}>{tag}</a><span>{count} {count === 1 ? 'post' : 'posts'}</span></li>
    ))}
  </ul>
</Base>
