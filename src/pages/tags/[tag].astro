---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ExternalIcon from '../../components/ExternalIcon.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const tags = new Map<string, typeof posts>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      const key = tag.toLowerCase();
      if (!tags.has(key)) tags.set(key, []);
      tags.get(key)!.push(post);
    }
  }
  return [...tags.entries()].map(([tag, posts]) => ({
    params: { tag },
    props: { tag, posts: posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()) },
  }));
}

const { tag, posts } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const host = (url: string) => new URL(url).hostname.replace(/^www\./, '');
---
<Base title={`Tag: ${tag}`}>
  <section class="page-head" aria-labelledby="tag-title">
    <h1 id="tag-title">{tag}</h1>
    <p class="page-head__status">{posts.length} {posts.length === 1 ? 'post' : 'posts'} · <a href="/tags">All tags</a></p>
  </section>
  <ul class="entries" style="margin-top: var(--space-5); border-top: 2px solid var(--rule);">
    {posts.map((post) => (
      <li class="entry">
        <time class="entry__date" datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
        <div>
          <h2 class="entry__title">
            <a href={post.data.redirectTo ?? `/${post.id}`}>{post.data.title}</a>
            {post.data.redirectTo && <span class="entry__ext"> on {host(post.data.redirectTo)} <ExternalIcon /></span>}
          </h2>
          {post.data.description && <p class="entry__excerpt">{post.data.description}</p>}
        </div>
      </li>
    ))}
  </ul>
</Base>
