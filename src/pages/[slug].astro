---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { allSteps, seriesPath, seriesTitle } from '../data/ai-series';
import SeriesCells from '../components/SeriesCells.astro';
import Invite from '../components/Invite.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;

// Series position: the hub is "Start", the rest are numbered steps.
// Prev/next skip steps whose post does not exist yet.
const published = new Set((await getCollection('posts')).map((p) => p.id));
const stepIndex = allSteps.findIndex((step) => step.slug === post.id);
const inSeries = stepIndex !== -1;
const stepLabel = stepIndex === 0 ? 'Start here' : `Step ${stepIndex} of ${allSteps.length - 1}`;
const findLive = (from: number, dir: number) => {
  for (let i = from + dir; i >= 0 && i < allSteps.length; i += dir) {
    const step = allSteps[i];
    if (step.slug && published.has(step.slug)) return step;
  }
  return undefined;
};
const prevStep = inSeries ? findLive(stepIndex, -1) : undefined;
const nextStep = inSeries ? findLive(stepIndex, 1) : undefined;
const { Content, headings } = await render(post);
// "On this page": the post's sections (h2 after the heading shift in
// astro.config), with any leading emoji dropped from the list.
const toc = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ slug: h.slug, text: h.text.replace(/^[^\p{L}\p{N}]+/u, '').trim() }));
const hasRail = !post.data.redirectTo && toc.length > 1;
const dateFormatted = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const isoDate = post.data.date.toISOString();

// TL;DR items allow `code` and **bold**; everything else is escaped.
const inline = (text: string) =>
  text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/`([^`]+)`/g, '<code>$1</code>')
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
---
<Base title={post.data.title} description={post.data.description} ogImage={post.data.image} redirectTo={post.data.redirectTo}>
  <article class:list={['post', { 'post--rail': hasRail }]}>
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <time datetime={isoDate}>{dateFormatted}</time>
        {inSeries && (
          <span class="post-meta__step"><a href={seriesPath}>{seriesTitle}</a> · {stepLabel}</span>
        )}
        {post.data.tags.length > 0 && (
          <span>
            {post.data.tags.map((tag, i) => (
              <>{i > 0 && ', '}<a href={`/tags/${tag.toLowerCase()}`}>{tag}</a></>
            ))}
          </span>
        )}
      </div>
    </header>

    <div class="post-main">
    {post.data.redirectTo && (
      <div class="redirect-notice">
        <strong>This post lives on an external site.</strong>{' '}
        Read it on <a href={post.data.redirectTo}>{new URL(post.data.redirectTo).hostname}</a>. You're being redirected automatically.
      </div>
    )}

    {post.data.tldr && post.data.tldr.length > 0 && (
      <aside class="tldr" aria-label="TL;DR">
        <p class="tldr__label">TL;DR</p>
        <ul>
          {post.data.tldr.map((item) => <li set:html={inline(item)} />)}
        </ul>
      </aside>
    )}

    <div class="post-content">
      <Content />
    </div>

    {inSeries && (
      <nav class="series-nav" aria-label={`${seriesTitle} series`}>
        <p class="series-nav__head"><strong>{seriesTitle} · {stepLabel}</strong> <a href={seriesPath}>See the whole path</a></p>
        <SeriesCells current={post.id} />
        <div class="series-nav__links">
          {prevStep ? (
            <a class="series-nav__link" href={`/${prevStep.slug}`}><span>Previous</span>{prevStep.title}</a>
          ) : <span />}
          {nextStep && (
            <a class="series-nav__link series-nav__link--next" href={`/${nextStep.slug}`}><span>Next</span>{nextStep.title}</a>
          )}
        </div>
      </nav>
    )}

    {!post.data.redirectTo && (
      <div class="post-footer">
        <Invite />
      </div>
    )}
    </div>
    {hasRail && (
      <aside class="post-rail" aria-label="On this page">
        <div class="post-rail__inner">
          <p class="post-rail__label">On this page</p>
          <ol class="toc">
            {toc.map((h) => (
              <li><a class="toc__link" href={`#${h.slug}`}><span class="toc__cell" aria-hidden="true"></span>{h.text}</a></li>
            ))}
          </ol>
          {inSeries && (
            <p class="post-rail__series"><a href={seriesPath}>{seriesTitle}</a> · {stepLabel}</p>
          )}
        </div>
      </aside>
    )}
  </article>
  {hasRail && (
    <script>
      // Mark the section being read: the last heading that has scrolled
      // past the top third of the viewport.
      const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc__link')];
      const heads = links
        .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
        .filter((h): h is HTMLElement => !!h);
      const mark = () => {
        const line = window.innerHeight * 0.33;
        let current = 0;
        heads.forEach((h, i) => { if (h.getBoundingClientRect().top <= line) current = i; });
        links.forEach((a, i) => {
          if (i === current) a.setAttribute('aria-current', 'location');
          else a.removeAttribute('aria-current');
        });
      };
      mark();
      window.addEventListener('scroll', mark, { passive: true });
      window.addEventListener('resize', mark, { passive: true });
    </script>
  )}
</Base>
