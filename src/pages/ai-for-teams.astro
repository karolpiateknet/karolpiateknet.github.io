---
import Base from '../layouts/Base.astro';
import SeriesCells from '../components/SeriesCells.astro';
import SeriesMap from '../components/SeriesMap.astro';
import Invite from '../components/Invite.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import { seriesTitle } from '../data/ai-series';
import { getSeriesStatus } from '../data/series-status';

const { start, liveCount, totalCount } = await getSeriesStatus();
---
<Base
  title={`${seriesTitle}: a step-by-step path`}
  description="How an engineering team goes from a few people trying AI to a system that compounds: from one engineer and an agent, through guardrails and team flow, to owning AI like a platform."
>
  <section class="page-head" aria-labelledby="series-title">
    <h1 id="series-title">{seriesTitle}, step by step</h1>
    <p class="page-head__status">{liveCount} of {totalCount} steps published · a new one about every week</p>
    <p class="page-head__lede">
      The path a team actually walks with AI agents, from the habits one engineer can start tomorrow to owning AI like CI. Each step builds on the one before it, and each one comes from running it on a real team.
    </p>
    <div class="series-strip"><SeriesCells /></div>
    {start.live && <a class="action" href={`/${start.slug}`}>Start here: {start.title} <ArrowIcon /></a>}
  </section>

  <section class="section" aria-labelledby="levels">
    <div class="section__head">
      <h2 id="levels">The path, level by level</h2>
    </div>
    <SeriesMap blurbs />
  </section>

  <Invite />
</Base>
