---
import Base from '../layouts/Base.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import PixelIcon from '../components/PixelIcon.astro';
---
<Base title="Page not found" description="This page does not exist on Swifty Friday.">
  <section class="lost" aria-labelledby="lost-title">
    <div class="lost__mark" aria-hidden="true">
      <PixelIcon name="lost" class="lost__icon" />
      <p class="lost__code">404</p>
    </div>
    <h1 id="lost-title">This page isn’t here.</h1>
    <p class="page-head__lede">The link may be old or mistyped. Every post still lives at its original address, so the series or the full list will get you there.</p>
    <div class="lost__links">
      <a class="action" href="/ai-for-teams">Go to AI for teams <ArrowIcon /></a>
      <a class="action action--quiet" href="/#writing">All writing</a>
    </div>
  </section>
</Base>
