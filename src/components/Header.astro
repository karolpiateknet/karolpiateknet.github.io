---
const { pathname } = Astro.url;
const isHome = pathname === '/' || pathname === '';
const current = (prefix: string) => (pathname.startsWith(prefix) ? 'page' : undefined);
---
<header class="site-header">
  <div class="page site-header__inner">
    <a href="/" class="site-header__brand" aria-current={isHome ? 'page' : undefined}>
      <span class="site-header__name">Karol Piątek</span>
      <span class="site-header__site">Swifty Friday</span>
    </a>
    <nav class="site-nav" aria-label="Primary">
      <a href="/ai-for-teams" aria-current={current('/ai-for-teams')}>AI for teams</a>
      <a href="/writing" aria-current={current('/writing')}>Writing</a>
      <a href="/about" aria-current={current('/about')}>About</a>
      <a href="/tags" aria-current={current('/tags')}>Tags</a>
    </nav>
  </div>
</header>
